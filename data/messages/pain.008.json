    { "path": "PmtInf.DrctDbtTxInf.DrctDbtTx.MndtRltdInf.DtOfSgntr", "name": "Date Of Signature", "card": "[0..1]", "type": "date", "tier": 1, "note": "When the debtor authorised the collection. SEPA mandates lapse after 36 months with no collection." },
    { "path": "PmtInf.DrctDbtTxInf.DrctDbtTx.MndtRltdInf.AmdmntInd", "name": "Amendment Indicator", "card": "[0..1]", "type": "indicator", "tier": 2 },
