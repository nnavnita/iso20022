{
  "id": "pacs.028.001.03",
  "short": "pacs.028",
  "name": "FIToFIPaymentStatusRequest",
  "domain": "pacs",
  "label": "FI to FI Payment Status Request",
  "direction": "bank → bank",
  "mtEquivalent": [
    "MT199",
    "MT299"
  ],
  "related": [
    "pacs.008",
    "pacs.002",
    "camt.056"
  ],
  "summary": "Asks an agent what happened to a payment. A pull-based enquiry for when the expected pacs.002 never arrived.",
  "whenUsed": "Sent when a payment has gone quiet — no status, no settlement confirmation, and the customer is asking. The receiving agent answers with a pacs.002. Introduced to replace the free-format MT199 enquiries that previously had to be read by a human.",
  "gotchas": [
    "This asks a question; it does not change anything. To actually stop or recall a payment you need camt.056. Sending pacs.028 when you meant to recall wastes the window in which recall is still possible.",
    "Identify the payment by UETR wherever you can. Matching on Original Instruction Id fails across hops because that reference is replaced at every agent.",
    "There is no status in this message. A pacs.028 containing a status is a misunderstanding of the direction of the exchange."
  ],
