    { "path": "DrctDbtTxInf.DrctDbtTx.MndtRltdInf.AmdmntInd", "name": "Amendment Indicator", "card": "[0..1]", "type": "indicator", "tier": 2, "note": "True when something about the mandate changed; the previous values then go in Amendment Information Details." },
