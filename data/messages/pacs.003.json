    { "path": "DrctDbtTxInf.DrctDbtTx.CdtrSchmeId", "name": "Creditor Scheme Identification", "card": "[0..1]", "type": "group", "tier": 1, "note": "The creditor's scheme identifier. For SEPA this is the Creditor Identifier (CI), and the debtor's bank validates collections against it." },
