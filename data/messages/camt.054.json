{
  "id": "camt.054.001.08",
  "short": "camt.054",
  "name": "BankToCustomerDebitCreditNotification",
  "domain": "camt",
  "label": "Bank To Customer Debit Credit Notification",
  "direction": "bank → customer",
  "mtEquivalent": [
    "MT900",
    "MT910"
  ],
  "related": [
    "camt.052",
    "camt.053",
    "pacs.008"
  ],
  "summary": "A push notification that a single debit or credit has hit an account. Event-driven, rather than the periodic sweep that camt.052 and camt.053 provide.",
  "whenUsed": "Real-time cash visibility: telling a corporate that an inbound payment has arrived so it can release goods, or confirming an outbound debit. Replaces MT900 (debit confirmation) and MT910 (credit confirmation). Also used to notify batches of returns and collections.",
  "gotchas": [
    "A notification is not a statement entry and does not guarantee the figure will be identical on the camt.053 — charges may be applied afterwards. Reconcile against the statement, use notifications to trigger action.",
    "Delivery is not guaranteed in order or exactly once. A missed or duplicated notification must not change your ledger; de-duplicate on AcctSvcrRef.",
    "No balance is required in this message. Code that assumes a notification tells you the new account balance will be disappointed — if you need a balance, ask for a camt.052."
  ],
