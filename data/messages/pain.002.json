      "path": "OrgnlPmtInfAndSts.TxInfAndSts.OrgnlTxRef",
      "name": "Original Transaction Reference",
      "card": "[0..1]",
      "type": "group",
      "tier": 2,
      "note": "Copy of the payment as the bank understood it. Comparing it against what you sent is the fastest way to find a mapping bug."
