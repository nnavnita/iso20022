      "name": "Original UETR",
      "card": "[0..1]",
      "type": "text",
      "tier": 2,
      "note": "Present once the bank has assigned one and can tell you how to track the payment onward."
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.TxSts",
      "name": "Transaction Status",
      "card": "[0..1]",
      "type": "code",
      "codelist": "TxSts",
      "tier": 1
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.StsRsnInf",
      "name": "Status Reason Information",
      "card": "[0..n]",
      "type": "group",
      "tier": 1
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.StsRsnInf.Rsn",
      "name": "Reason",
      "card": "[0..1]",
      "type": "group",
      "tier": 1
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.StsRsnInf.Rsn.Cd",
      "name": "Reason Code",
      "card": "[0..1]",
      "type": "code",
      "codelist": "StsRsn",
      "tier": 1
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.StsRsnInf.AddtlInf",
      "name": "Additional Information",
      "card": "[0..n]",
      "type": "text",
      "tier": 1
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.AccptncDtTm",
      "name": "Acceptance Date Time",
      "card": "[0..1]",
      "type": "datetime",
      "tier": 2
    },
    {
      "path": "OrgnlPmtInfAndSts.TxInfAndSts.ChrgsInf",
      "name": "Charges Information",
      "card": "[0..n]",
      "type": "group",
      "tier": 3
