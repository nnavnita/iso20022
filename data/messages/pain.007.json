{
  "id": "pain.007.001.09",
  "short": "pain.007",
  "name": "CustomerPaymentReversal",
  "domain": "pain",
  "label": "Customer Payment Reversal",
  "direction": "customer → bank",
  "mtEquivalent": [],
  "related": [
    "pain.008",
    "pacs.003",
    "pacs.004",
    "pain.002"
  ],
  "summary": "A creditor telling its bank to undo a collection it previously initiated. Self-correction by the party that started the collection — not a dispute raised by the payer.",
  "whenUsed": "Sent after a pain.008 collection has gone out and the creditor realises it was wrong: duplicated, the wrong amount, or against a cancelled mandate. Must be submitted inside the scheme's reversal window — for SEPA that is a small number of business days after settlement, after which only the debtor's refund rights remain.",
  "gotchas": [
    "This is the creditor admitting its own error. A debtor disputing a collection does not use this message; that is a refund or a return initiated on the debtor's side, with different rights and different timeframes.",
    "The reversal window is short and scheme-specific. Miss it and the message will be rejected, leaving commercial settlement as the only remedy.",
    "Original fields must echo the pain.008 exactly. Reversing by amount and name rather than by OrgnlEndToEndId is how the wrong collection gets reversed."
  ],
