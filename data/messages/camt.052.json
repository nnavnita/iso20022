{
  "id": "camt.052.001.08",
  "short": "camt.052",
  "name": "BankToCustomerAccountReport",
  "domain": "camt",
  "label": "Bank To Customer Account Report",
  "direction": "bank → customer",
  "mtEquivalent": [
    "MT941",
    "MT942"
  ],
  "related": [
    "camt.053",
    "camt.054",
    "camt.060"
  ],
  "summary": "An intraday view of an account: current balances and the activity so far today, including items that have not yet been booked.",
  "whenUsed": "Intraday liquidity management and cash positioning — delivered on a schedule (hourly, or several times a day) or pulled on demand with a camt.060. Replaces MT941 (balance report) and MT942 (interim transaction report).",
  "gotchas": [
    "This is not a statement and carries no finality. Entries can be PDNG now and change or vanish before the camt.053 arrives. Reconciling your ledger against a camt.052 will produce breaks that resolve themselves, wasting the time of whoever investigates them.",
    "Because it is structurally almost identical to camt.053, it is easy to feed both into the same parser and lose track of which is authoritative. Key your storage on the message type, not just the account and date.",
    "Balance types are what distinguish the two messages' meaning: expect ITBD and ITAV (interim) here, versus OPBD and CLBD (booked bookends) in a statement."
  ],
